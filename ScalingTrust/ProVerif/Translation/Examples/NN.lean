theorem dhexp_eq_some {x₀ x₁ m₀ : T.Msg} :
    dhexp x₀ x₁ = some m₀ ↔
      x₁ = zero ∧ m₀ = zero ∨ ¬x₁ = zero ∧ ∃ k, x₁ = validkey k ∧ m₀ = dhexp_real x₀ k :=
  ⟨fun h₀ => by
    rw [dhexp.eq_def, join_eq_some, orElse_eq_some] at h₀
    rcases h₀ with h₀ | ⟨n₀, h₀⟩
    · refine Or.inl ?_
      simp at h₀
      rcases h₀ with ⟨h₁, h₂⟩
      subst h₂
      exact ⟨h₁, rfl⟩
    · refine Or.inr ⟨?_, ?_⟩
      · intro hm₀
        rcases hm₀ with rfl
        simp [zero] at n₀
      · rcases hv₀ : x₁.view with _ | ⟨f₀, a₀⟩ | _ <;> simp [hv₀] at h₀
        rcases f₀ with f₀ | f₀ <;> cases f₀ <;> try simp at h₀
        subst h₀
        have e₀ : x₁ = validkey (a₀ 0) :=
          x₁.eq_app_of_view' hv₀
            (by
              intro i₀
              fin_cases i₀
              · exact rfl)
        exact ⟨a₀ 0, e₀, rfl⟩, fun h₀ =>
    by
    have r₀ : ∀ o, (if x₁ = zero then some (some zero) else none) = some o → x₁ = zero :=
      fun o₀ ho₀ => by
      simp at ho₀
      rcases ho₀ with ⟨h₁, -⟩
      exact h₁
    rcases h₀ with d₀ | (d₁)
    · rcases d₀ with ⟨rfl, rfl⟩
      rw [dhexp.eq_def, join_eq_some, orElse_eq_some]
      refine Or.inl ?_
      simp [zero]
    · rcases d₁ with ⟨n₀, k, rfl, rfl⟩
      rw [dhexp.eq_def, join_eq_some, orElse_eq_some]
      refine Or.inr ⟨?_, ?_⟩
      · by_contra hne₀
        obtain ⟨o₀, ho₀⟩ := Option.ne_none_iff_exists'.1 hne₀
        exact n₀ (r₀ o₀ ho₀)
      · simp [validkey, free]⟩

