  | py
  | pz

/-- `query c, m, sid_a, sid_b, s, b, px, py, pz; attacker(msg_a(alice, bob, sid_a))` -/
def query₉ : Prop :=
  ∀ σ : Vars₉ → T.Msg, system.Secret (msg_a alice bob (σ .sid_a))

/-- The variables of `query c, m, sid_a, sid_b, s, b, px, py, pz; event(RecvMsg(alice, bob, stagepack_b(sid_a), m)) ==> event(SendMsg(bob, alice, stagepack_b(sid_b), m))`. -/
inductive Vars₁₀
  | c
  | m
  | sid_a
  | sid_b
