theorem equal_eq_some {x₀ x₁ m₀ : T.Msg} :
    equal x₀ x₁ = some m₀ ↔ x₁ = x₀ ∧ m₀ = (true : T.Msg) ∨ ¬x₁ = x₀ ∧ m₀ = (false : T.Msg) :=
  ⟨fun h₀ => by
    rw [equal.eq_def, join_eq_some, orElse_eq_some] at h₀
    rcases h₀ with h₀ | ⟨n₀, h₀⟩
    · refine Or.inl ?_
      simp at h₀
      rcases h₀ with ⟨h₁, h₂⟩
      subst h₂
      exact ⟨h₁, rfl⟩
    · refine Or.inr ⟨?_, ?_⟩
      · intro hm₀
        rcases hm₀ with rfl
        simp at n₀
      · simp at h₀
        subst h₀
        exact rfl, fun h₀ =>
    by
    have r₀ : ∀ o, (if x₁ = x₀ then some (some (true : T.Msg)) else none) = some o → x₁ = x₀ :=
      fun o₀ ho₀ => by
      simp at ho₀
      rcases ho₀ with ⟨h₁, -⟩
      exact h₁
    rcases h₀ with d₀ | (d₁)
    · rcases d₀ with ⟨rfl, rfl⟩
      rw [equal.eq_def, join_eq_some, orElse_eq_some]
      refine Or.inl ?_
      simp
    · rcases d₁ with ⟨n₀, rfl⟩
      rw [equal.eq_def, join_eq_some, orElse_eq_some]
      refine Or.inr ⟨?_, ?_⟩
      · by_contra hne₀
        obtain ⟨o₀, ho₀⟩ := Option.ne_none_iff_exists'.1 hne₀
        exact n₀ (r₀ o₀ ho₀)
      · simp⟩

theorem not_eq_some {x₀ m₀ : T.Msg} :
    not x₀ = some m₀ ↔
      x₀ = (true : T.Msg) ∧ m₀ = (false : T.Msg) ∨ ¬x₀ = (true : T.Msg) ∧ m₀ = (true : T.Msg) :=
  ⟨fun h₀ => by
    rw [not.eq_def, join_eq_some, orElse_eq_some] at h₀
    rcases h₀ with h₀ | ⟨n₀, h₀⟩
    · refine Or.inl ?_
      simp at h₀
      rcases h₀ with ⟨h₁, h₂⟩
      subst h₂
      exact ⟨h₁, rfl⟩
    · refine Or.inr ⟨?_, ?_⟩
      · intro hm₀
        rcases hm₀ with rfl
        simp at n₀
      · simp at h₀
        subst h₀
        exact rfl, fun h₀ =>
    by
    have r₀ :
      ∀ o,
        (if x₀ = (true : T.Msg) then some (some (false : T.Msg)) else none) = some o →
          x₀ = (true : T.Msg) :=
      fun o₀ ho₀ => by
      simp at ho₀
      rcases ho₀ with ⟨h₁, -⟩
      exact h₁
    rcases h₀ with d₀ | (d₁)
    · rcases d₀ with ⟨rfl, rfl⟩
      rw [not.eq_def, join_eq_some, orElse_eq_some]
      refine Or.inl ?_
      simp
    · rcases d₁ with ⟨n₀, rfl⟩
      rw [not.eq_def, join_eq_some, orElse_eq_some]
      refine Or.inr ⟨?_, ?_⟩
      · by_contra hne₀
        obtain ⟨o₀, ho₀⟩ := Option.ne_none_iff_exists'.1 hne₀
        exact n₀ (r₀ o₀ ho₀)
      · simp⟩

theorem and_eq_some {u₀ u₁ : Option T.Msg} {m₀ : T.Msg} :
    and u₀ u₁ = some m₀ ↔
      u₀ = some (true : T.Msg) ∧ u₁ = some m₀ ∨
        ¬u₀ = some (true : T.Msg) ∧ ∃ x, u₀ = some x ∧ m₀ = (false : T.Msg) :=
  ⟨fun h₀ => by
    rw [and.eq_def, join_eq_some, orElse_eq_some] at h₀
    rcases h₀ with h₀ | ⟨n₀, h₀⟩
    · refine Or.inl ?_
      rcases u₀ with _ | x₀ <;> simp at h₀
      rcases h₀ with ⟨h₁, h₂⟩
      subst h₂
      exact ⟨congrArg some h₁, rfl⟩
    · refine Or.inr ⟨?_, ?_⟩
      · intro hm₀
        rcases hm₀ with rfl
        simp at n₀
      · rcases u₀ with _ | x₀ <;> simp at h₀
        subst h₀
        exact ⟨x₀, rfl, rfl⟩, fun h₀ =>
    by
    have r₀ :
      ∀ o,
        (match u₀ with
            | some x₀ => if x₀ = (true : T.Msg) then some u₁ else none
            | none => none) =
            some o →
          u₀ = some (true : T.Msg) :=
      fun o₀ ho₀ => by
      rcases u₀ with _ | x₀ <;> simp at ho₀
      rcases ho₀ with ⟨h₁, -⟩
      exact congrArg some h₁
    rcases h₀ with d₀ | (d₁)
    · rcases d₀ with ⟨rfl, rfl⟩
      rw [and.eq_def, join_eq_some, orElse_eq_some]
      refine Or.inl ?_
      simp
    · rcases d₁ with ⟨n₀, x, rfl, rfl⟩
      rw [and.eq_def, join_eq_some, orElse_eq_some]
      refine Or.inr ⟨?_, ?_⟩
      · by_contra hne₀
        obtain ⟨o₀, ho₀⟩ := Option.ne_none_iff_exists'.1 hne₀
        exact n₀ (r₀ o₀ ho₀)
      · simp⟩

theorem or_eq_some {u₀ u₁ : Option T.Msg} {m₀ : T.Msg} :
    or u₀ u₁ = some m₀ ↔
      u₀ = some (true : T.Msg) ∧ m₀ = (true : T.Msg) ∨
        ¬u₀ = some (true : T.Msg) ∧ ∃ x, u₀ = some x ∧ u₁ = some m₀ :=
  ⟨fun h₀ => by
    rw [or.eq_def, join_eq_some, orElse_eq_some] at h₀
    rcases h₀ with h₀ | ⟨n₀, h₀⟩
    · refine Or.inl ?_
      rcases u₀ with _ | x₀ <;> simp at h₀
      rcases h₀ with ⟨h₁, h₂⟩
      subst h₂
      exact ⟨congrArg some h₁, rfl⟩
    · refine Or.inr ⟨?_, ?_⟩
      · intro hm₀
        rcases hm₀ with rfl
        simp at n₀
      · rcases u₀ with _ | x₀ <;> simp at h₀
        subst h₀
        exact ⟨x₀, rfl, rfl⟩, fun h₀ =>
    by
    have r₀ :
      ∀ o,
        (match u₀ with
            | some x₀ => if x₀ = (true : T.Msg) then some (some (true : T.Msg)) else none
            | none => none) =
            some o →
          u₀ = some (true : T.Msg) :=
      fun o₀ ho₀ => by
      rcases u₀ with _ | x₀ <;> simp at ho₀
      rcases ho₀ with ⟨h₁, -⟩
      exact congrArg some h₁
    rcases h₀ with d₀ | (d₁)
    · rcases d₀ with ⟨rfl, rfl⟩
      rw [or.eq_def, join_eq_some, orElse_eq_some]
      refine Or.inl ?_
      simp
    · rcases d₁ with ⟨n₀, x, rfl, rfl⟩
      rw [or.eq_def, join_eq_some, orElse_eq_some]
      refine Or.inr ⟨?_, ?_⟩
      · by_contra hne₀
        obtain ⟨o₀, ho₀⟩ := Option.ne_none_iff_exists'.1 hne₀
        exact n₀ (r₀ o₀ ho₀)
      · simp⟩

/-! ## The attacker -/

/-- The public symbols: all but the private free names and constructors, and the events. -/
def pub : ∀ n, Fun n → Prop
  | _, .const .statestore => False
  | _, .msg_a => False
  | _, .msg_b => False
  | _, .msg_c => False
  | _, .msg_d => False
  | _, .key_s => False
  | _, .key_e => False
  | _, .key_psk => False
  | _, .Error => False
  | _, .SendEnd => False
  | _, .RecvEnd => False
  | _, .SendMsg => False
  | _, .RecvMsg => False
  | _, .LeakS => False
  | _, .LeakPsk => False
  | _, .RepeatingKey_a => False
  | _, .RepeatingKey_b => False
  | _, .RepeatingKey_c => False
  | _, .RepeatingKey_d => False
  | _, _ => True

/-- The attacker: the public constructors, including the public free names, the public destructors, and the standard operations. -/
instance : Attacker T.Msg :=
  .ofDecls (fun n => {f | pub n f})
    {⟨1, liftFail fun a => keypairunpack (a 0)⟩, ⟨1, liftFail fun a => getpublickey (a 0)⟩,
      ⟨1, liftFail fun a => aeadunpack (a 0)⟩, ⟨1, liftFail fun a => cipherstateunpack (a 0)⟩,
      ⟨1, liftFail fun a => symmetricstateunpack (a 0)⟩,
      ⟨1, liftFail fun a => handshakestateunpack (a 0)⟩,
      ⟨2, liftFail fun a => handshakestatesetcs (a 0) (a 1)⟩,
      ⟨1, liftFail fun a => handshakestategetcs (a 0)⟩, ⟨1, liftFail fun a => deconcat3 (a 0)⟩,
      ⟨1, liftFail fun a => decrement_nonce (a 0)⟩, ⟨2, liftFail fun a => dhexp (a 0) (a 1)⟩,
      ⟨4, liftFail fun a => decrypt (a 0) (a 1) (a 2) (a 3)⟩,
      ⟨1, liftFail fun a => stagepack_a₁ (a 0)⟩, ⟨1, liftFail fun a => stagepack_b₁ (a 0)⟩,
      ⟨1, liftFail fun a => stagepack_c₁ (a 0)⟩, ⟨1, liftFail fun a => stagepack_d₁ (a 0)⟩,
      ⟨1, liftFail fun a => statepack_a₁ (a 0)⟩, ⟨1, liftFail fun a => statepack_b₁ (a 0)⟩,
      ⟨1, liftFail fun a => statepack_c₁ (a 0)⟩, ⟨1, liftFail fun a => statepack_c₂ (a 0)⟩,
      ⟨1, liftFail fun a => statepack_c₃ (a 0)⟩, ⟨1, liftFail fun a => statepack_d₁ (a 0)⟩,
      ⟨1, liftFail fun a => statepack_d₂ (a 0)⟩, ⟨1, liftFail fun a => statepack_d₃ (a 0)⟩,
      ⟨1, liftFail fun a => keypairpack₁ (a 0)⟩, ⟨1, liftFail fun a => keypairpack₂ (a 0)⟩,
      ⟨1, liftFail fun a => aeadpack₁ (a 0)⟩, ⟨1, liftFail fun a => aeadpack₂ (a 0)⟩,
      ⟨1, liftFail fun a => aeadpack₃ (a 0)⟩, ⟨1, liftFail fun a => cipherstatepack₁ (a 0)⟩,
      ⟨1, liftFail fun a => cipherstatepack₂ (a 0)⟩,
      ⟨1, liftFail fun a => symmetricstatepack₁ (a 0)⟩,
      ⟨1, liftFail fun a => symmetricstatepack₂ (a 0)⟩,
      ⟨1, liftFail fun a => symmetricstatepack₃ (a 0)⟩,
      ⟨1, liftFail fun a => handshakestatepack₁ (a 0)⟩,
      ⟨1, liftFail fun a => handshakestatepack₂ (a 0)⟩,
      ⟨1, liftFail fun a => handshakestatepack₃ (a 0)⟩,
      ⟨1, liftFail fun a => handshakestatepack₄ (a 0)⟩,
      ⟨1, liftFail fun a => handshakestatepack₅ (a 0)⟩,
      ⟨1, liftFail fun a => handshakestatepack₆ (a 0)⟩,
      ⟨1, liftFail fun a => handshakestatepack₇ (a 0)⟩, ⟨1, liftFail fun a => concat3₁ (a 0)⟩,
      ⟨1, liftFail fun a => concat3₂ (a 0)⟩, ⟨1, liftFail fun a => concat3₃ (a 0)⟩}

/-! ## Function macros -/

/-- `dh(my_keypair, pubkey) = let (my_public_key, my_private_key) = keypairunpack(my_keypair) in dhexp(my_private_key, pubkey)` -/
def dh (my_keypair pubkey : T.Msg) : Option T.Msg :=
  match keypairunpack my_keypair with
  | some t₀ =>
    match Tuple.ofMsg (T.Msg × T.Msg) t₀ with
    | some (_my_public_key, my_private_key) => dhexp my_private_key pubkey
    | none => none
  | none => none

/-- `generate_keypair(basis) = let public_key = dhexp(basis, validkey(g)) in keypairpack(validkey(public_key), basis)` -/
def generate_keypair (basis : T.Msg) : Option T.Msg :=
  match dhexp basis (validkey g) with
  | some public_key => some (keypairpack (validkey public_key) basis)
  | none => none

/-- `hkdf(chaining_key, input_key_material) = let output1 = hmac_hash1(chaining_key, input_key_material) in let output2 = hmac_hash2(chaining_key, input_key_material) in let output3 = hmac_hash3(chaining_key, input_key_material) in (output1, output2, output3)` -/
def hkdf (chaining_key input_key_material : T.Msg) : T.Msg :=
  let output1 := hmac_hash1 chaining_key input_key_material;
  let output2 := hmac_hash2 chaining_key input_key_material;
  let output3 := hmac_hash3 chaining_key input_key_material;
  ((output1, output2, output3) : T.Msg)

/-- `initializeKey(k) = cipherstatepack(k, minnonce)` -/
def initializeKey (k : T.Msg) : T.Msg :=
  cipherstatepack k minnonce

/-- `hasKey(cs) = let (k, n) = cipherstateunpack(cs) in k <> bit2key(empty)` -/
def hasKey (cs : T.Msg) : Option T.Msg :=
  match cipherstateunpack cs with
  | some t₁ =>
    match Tuple.ofMsg (T.Msg × T.Msg) t₁ with
    | some (k, _n) => equal k empty >>= fun t₀ => not t₀
    | none => none
  | none => none

/-- `setNonce(cs, n) = let (k, o) = cipherstateunpack(cs) in cipherstatepack(k, n)` -/
def setNonce (cs n : T.Msg) : Option T.Msg :=
  match cipherstateunpack cs with
  | some t₀ =>
    match Tuple.ofMsg (T.Msg × T.Msg) t₀ with
    | some (k, _o) => some (cipherstatepack k n)
    | none => none
  | none => none

/-- `encryptWithAd(cs, ad, plaintext) = let (k, n) = cipherstateunpack(cs) in let e = encrypt(k, n, ad, plaintext) in let csi = setNonce(cs, increment_nonce(n)) in (csi, e)` -/
def encryptWithAd (cs ad plaintext : T.Msg) : Option T.Msg :=
  match cipherstateunpack cs with
  | some t₀ =>
    match Tuple.ofMsg (T.Msg × T.Msg) t₀ with
    | some (k, n) =>
      let e := encrypt k n ad plaintext;
      match setNonce cs (increment_nonce n) with
      | some csi => some ((csi, e) : T.Msg)
      | none => none
    | none => none
  | none => none

/-- `decryptWithAd(cs, ad, ciphertext) = let (k, n) = cipherstateunpack(cs) in let d = decrypt(k, n, ad, ciphertext) in let (valid, adi, plaintext) = aeadunpack(d) in let csi = setNonce(cs, increment_nonce(n)) in (csi, plaintext, valid)` -/
def decryptWithAd (cs ad ciphertext : T.Msg) : Option T.Msg :=
  match cipherstateunpack cs with
  | some t₁ =>
    match Tuple.ofMsg (T.Msg × T.Msg) t₁ with
    | some (k, n) =>
      match decrypt k n ad ciphertext with
      | some d =>
        match aeadunpack d with
        | some t₀ =>
          match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₀ with
          | some (valid, _adi, plaintext) =>
            match setNonce cs (increment_nonce n) with
            | some csi => some ((csi, plaintext, valid) : T.Msg)
            | none => none
          | none => none
        | none => none
      | none => none
    | none => none
  | none => none

/-- `reKey(cs) = let (k, n) = cipherstateunpack(cs) in let ki = encrypt(k, maxnonce, empty, zero) in cipherstatepack(bit2key(ki), n)` -/
def reKey (cs : T.Msg) : Option T.Msg :=
  match cipherstateunpack cs with
  | some t₀ =>
    match Tuple.ofMsg (T.Msg × T.Msg) t₀ with
    | some (k, n) =>
      some
        (let ki := encrypt k maxnonce empty zero;
        cipherstatepack ki n)
    | none => none
  | none => none

/-- `initializeSymmetric(protocol_name) = let h = hash(protocol_name, empty) in let ck = bit2key(h) in let cs = initializeKey(bit2key(empty)) in symmetricstatepack(cs, ck, h)` -/
def initializeSymmetric (protocol_name : T.Msg) : T.Msg :=
  let h := hash protocol_name empty;
  let ck := h;
  let cs := initializeKey empty;
  symmetricstatepack cs ck h

/-- `mixKey(ss, input_key_material) = let (cs, ck, h) = symmetricstateunpack(ss) in let (ck, temp_k, output_3) = hkdf(ck, input_key_material) in symmetricstatepack(initializeKey(temp_k), ck, h)` -/
def mixKey (ss input_key_material : T.Msg) : Option T.Msg :=
  match symmetricstateunpack ss with
  | some t₁ =>
    match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₁ with
    | some (_cs, ck, h) =>
      let t₀ := hkdf ck input_key_material;
      match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₀ with
      | some (ck, temp_k, _output_3) => some (symmetricstatepack (initializeKey temp_k) ck h)
      | none => none
    | none => none
  | none => none

/-- `mixHash(ss, data) = let (cs, ck, h) = symmetricstateunpack(ss) in symmetricstatepack(cs, ck, hash(h, data))` -/
def mixHash (ss data : T.Msg) : Option T.Msg :=
  match symmetricstateunpack ss with
  | some t₀ =>
    match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₀ with
    | some (cs, ck, h) => some (symmetricstatepack cs ck (hash h data))
    | none => none
  | none => none

/-- `mixKeyAndHash(ss, input_key_material) = let (cs, ck, h) = symmetricstateunpack(ss) in let (ck, temp_h, temp_k) = hkdf(ck, input_key_material) in let (cs, temp_ck, h) = symmetricstateunpack(mixHash(symmetricstatepack(cs, ck, h), key2bit(temp_h))) in symmetricstatepack(initializeKey(temp_k), ck, h)` -/
def mixKeyAndHash (ss input_key_material : T.Msg) : Option T.Msg :=
  match symmetricstateunpack ss with
  | some t₃ =>
    match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₃ with
    | some (cs, ck, h) =>
      let t₂ := hkdf ck input_key_material;
      match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₂ with
      | some (ck, temp_h, temp_k) =>
        match mixHash (symmetricstatepack cs ck h) temp_h >>= fun t₀ => symmetricstateunpack t₀ with
        | some t₁ =>
          match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₁ with
          | some (_cs, _temp_ck, h) => some (symmetricstatepack (initializeKey temp_k) ck h)
          | none => none
        | none => none
      | none => none
    | none => none
  | none => none

/-- `getHandshakeHash(ss) = let (cs, ck, h) = symmetricstateunpack(ss) in h` -/
def getHandshakeHash (ss : T.Msg) : Option T.Msg :=
  match symmetricstateunpack ss with
  | some t₀ =>
    match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₀ with
    | some (_cs, _ck, h) => some h
    | none => none
  | none => none

/-- `encryptAndHash(ss, plaintext) = let (cs, ck, h) = symmetricstateunpack(ss) in let (csi, ciphertext) = encryptWithAd(cs, h, plaintext) in let ssi = mixHash(symmetricstatepack(csi, ck, h), ciphertext) in (ssi, ciphertext)` -/
def encryptAndHash (ss plaintext : T.Msg) : Option T.Msg :=
  match symmetricstateunpack ss with
  | some t₁ =>
    match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₁ with
    | some (cs, ck, h) =>
      match encryptWithAd cs h plaintext with
      | some t₀ =>
        match Tuple.ofMsg (T.Msg × T.Msg) t₀ with
        | some (csi, ciphertext) =>
          match mixHash (symmetricstatepack csi ck h) ciphertext with
          | some ssi => some ((ssi, ciphertext) : T.Msg)
          | none => none
        | none => none
      | none => none
    | none => none
  | none => none

/-- `decryptAndHash(ss, ciphertext) = let (cs, ck, h) = symmetricstateunpack(ss) in let (csi, plaintext, valid) = decryptWithAd(cs, h, ciphertext) in let ssi = mixHash(symmetricstatepack(csi, ck, h), ciphertext) in (ssi, plaintext, valid)` -/
def decryptAndHash (ss ciphertext : T.Msg) : Option T.Msg :=
  match symmetricstateunpack ss with
  | some t₁ =>
    match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₁ with
    | some (cs, ck, h) =>
      match decryptWithAd cs h ciphertext with
      | some t₀ =>
        match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₀ with
        | some (csi, plaintext, valid) =>
          match mixHash (symmetricstatepack csi ck h) ciphertext with
          | some ssi => some ((ssi, plaintext, valid) : T.Msg)
          | none => none
        | none => none
      | none => none
    | none => none
  | none => none

/-- `split(ss) = let (cs, ck, h) = symmetricstateunpack(ss) in let (temp_k1, temp_k2, temp_k3) = hkdf(ck, bit2key(zero)) in let cs1 = initializeKey(temp_k1) in let cs2 = initializeKey(temp_k2) in (ss, cs1, cs2)` -/
def split (ss : T.Msg) : Option T.Msg :=
  match symmetricstateunpack ss with
  | some t₁ =>
    match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₁ with
    | some (_cs, ck, _h) =>
      let t₀ := hkdf ck zero;
      match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₀ with
      | some (temp_k1, temp_k2, _temp_k3) =>
        some
          (let cs1 := initializeKey temp_k1;
          let cs2 := initializeKey temp_k2;
          ((ss, cs1, cs2) : T.Msg))
      | none => none
    | none => none
  | none => none

/-- `initialize_initiator(prologue, s, e, rs, re, psk) = let ss = mixHash(initializeSymmetric(somename), prologue) in handshakestatepack(ss, s, e, rs, re, psk, true)` -/
def initialize_initiator (prologue s e rs re psk : T.Msg) : Option T.Msg :=
  match mixHash (initializeSymmetric somename) prologue with
  | some ss => some (handshakestatepack ss s e rs re psk (true : T.Msg))
  | none => none

/-- `initialize_responder(prologue, s, e, rs, re, psk) = let ss = mixHash(initializeSymmetric(somename), prologue) in handshakestatepack(ss, s, e, rs, re, psk, false)` -/
def initialize_responder (prologue s e rs re psk : T.Msg) : Option T.Msg :=
  match mixHash (initializeSymmetric somename) prologue with
  | some ss => some (handshakestatepack ss s e rs re psk (false : T.Msg))
  | none => none

/-- `writeMessage_a(me, them, hs, payload, sid) = let (ss, s, e, rs, re, psk, initiator) = handshakestateunpack(hs) in let (ne, ns, ciphertext) = (empty, empty, empty) in let e = generate_keypair(key_e(me, them, sid)) in let ne = key2bit(getpublickey(e)) in let ss = mixHash(ss, ne) in let (ss, ciphertext) = encryptAndHash(ss, payload) in let hs = handshakestatepack(ss, s, e, rs, re, psk, initiator) in let message_buffer = concat3(ne, ns, ciphertext) in (hs, message_buffer)` -/
def writeMessage_a (me them hs payload sid : T.Msg) : Option T.Msg :=
  match handshakestateunpack hs with
  | some t₂ =>
    match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg × T.Msg × T.Msg × T.Msg) t₂ with
    | some (ss, s, _e, rs, re, psk, initiator') =>
      let t₁ := ((empty, empty, empty) : T.Msg);
      match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₁ with
      | some (_ne, ns, _ciphertext) =>
        match generate_keypair (key_e me them sid) with
        | some e =>
          match getpublickey e with
          | some ne =>
            match mixHash ss ne with
            | some ss =>
              match encryptAndHash ss payload with
              | some t₀ =>
                match Tuple.ofMsg (T.Msg × T.Msg) t₀ with
                | some (ss, ciphertext) =>
                  some
                    (let hs := handshakestatepack ss s e rs re psk initiator';
                    let message_buffer := concat3 ne ns ciphertext;
                    ((hs, message_buffer) : T.Msg))
                | none => none
              | none => none
            | none => none
          | none => none
        | none => none
      | none => none
    | none => none
  | none => none

/-- `writeMessage_b(me, them, hs, payload, sid) = let (ss, s, e, rs, re, psk, initiator) = handshakestateunpack(hs) in let (ne, ns, ciphertext) = (empty, empty, empty) in let e = generate_keypair(key_e(me, them, sid)) in let ne = key2bit(getpublickey(e)) in let ss = mixHash(ss, ne) in let ss = mixKey(ss, dh(e, re)) in let (ss, ciphertext) = encryptAndHash(ss, payload) in let hs = handshakestatepack(ss, s, e, rs, re, psk, initiator) in let message_buffer = concat3(ne, ns, ciphertext) in let (ssi, cs1, cs2) = split(ss) in (hs, message_buffer, cs1, cs2)` -/
def writeMessage_b (me them hs payload sid : T.Msg) : Option T.Msg :=
  match handshakestateunpack hs with
  | some t₄ =>
    match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg × T.Msg × T.Msg × T.Msg) t₄ with
    | some (ss, s, _e, rs, re, psk, initiator') =>
      let t₃ := ((empty, empty, empty) : T.Msg);
      match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₃ with
      | some (_ne, ns, _ciphertext) =>
        match generate_keypair (key_e me them sid) with
        | some e =>
          match getpublickey e with
          | some ne =>
            match mixHash ss ne with
            | some ss =>
              match dh e re >>= fun t₀ => mixKey ss t₀ with
              | some ss =>
                match encryptAndHash ss payload with
                | some t₂ =>
                  match Tuple.ofMsg (T.Msg × T.Msg) t₂ with
                  | some (ss, ciphertext) =>
                    let hs := handshakestatepack ss s e rs re psk initiator';
                    let message_buffer := concat3 ne ns ciphertext;
                    match split ss with
                    | some t₁ =>
                      match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₁ with
                      | some (_ssi, cs1, cs2) => some ((hs, message_buffer, cs1, cs2) : T.Msg)
                      | none => none
                    | none => none
                  | none => none
                | none => none
              | none => none
            | none => none
          | none => none
        | none => none
      | none => none
    | none => none
  | none => none

