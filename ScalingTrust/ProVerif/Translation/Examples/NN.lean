  | py
  | pz

/-- `query c, m, sid_a, sid_b, s, b, px, py, pz; event(RecvMsg(alice, bob, stagepack_b(sid_a), m)) ==> event(SendMsg(bob, alice, stagepack_b(sid_b), m))` -/
