  | pz

/-- `query c, m, sid_a, sid_b, s, b, px, py, pz; event(RecvMsg(bob, alice, stagepack_a(sid_b), m)) ==> event(SendMsg(alice, bob, stagepack_a(sid_a), m)) || false` -/
def query₅ : Prop :=
