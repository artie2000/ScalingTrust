/-! ## The process -/

def initiator (me them sid : T.Msg) : Cont (Proc T.Msg) Unit := do
  let s := keypairpack empty empty
  if ← .fork then
    if ← .fork then
      if ← .fork then
        let e := keypairpack empty empty
        let rs := empty
        let re := empty
        match initialize_initiator empty s e rs re empty with
        | some hs =>
          let rec₀ := ((me, them, sid, statepack_a hs) : T.Msg)
          if ← .fork then
            .repl
            .send statestore rec₀
          else
            .stop
        | none =>
          .stop
      else
        let t₀ ← .recv statestore
        match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₀ with
        | some (t₁, t₂, t₃, t₄) =>
          if t₁ = me then
            if t₂ = them then
              if t₃ = sid then
                match statepack_a₁ t₄ with
                | some hs =>
                  match writeMessage_a me them hs (msg_a me them sid) sid with
                  | some t₅ =>
                    match Tuple.ofMsg (T.Msg × T.Msg) t₅ with
                    | some (hs, message_a) =>
                      .emit (SendMsg me them (stagepack_a sid) (msg_a me them sid))
                      let rec₀ := ((me, them, sid, statepack_b hs) : T.Msg)
                      if ← .fork then
                        .repl
                        .send statestore rec₀
                      else
                        .send pub' message_a
                    | none =>
                      .stop
                  | none =>
                    .stop
                | none =>
                  .stop
              else
                .stop
            else
              .stop
          else
            .stop
        | none =>
          .stop
    else
      let t₆ ← .recv statestore
      match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₆ with
      | some (t₇, t₈, t₉, t₁₀) =>
        if t₇ = me then
          if t₈ = them then
            if t₉ = sid then
              match statepack_b₁ t₁₀ with
              | some hs =>
                let message_b ← .recv pub'
                match readMessage_b me them hs message_b sid with
                | some t₁₁ =>
                  match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg × T.Msg) t₁₁ with
                  | some (hs, plaintext_b, _valid, cs1, cs2) =>
                    .emit (RecvMsg me them (stagepack_b sid) plaintext_b)
                    let rec₀ := ((me, them, sid, statepack_c hs cs1 cs2) : T.Msg)
                    if ← .fork then
                      .repl
                      .send statestore rec₀
                    else
                      .stop
                  | none =>
                    .stop
                | none =>
                  .stop
              | none =>
                .stop
            else
              .stop
          else
            .stop
        else
          .stop
      | none =>
        .stop
  else
    .repl
    if ← .fork then
      let t₁₂ ← .recv statestore
      match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₁₂ with
      | some (t₁₃, t₁₄, t₁₅, t₁₆) =>
        if t₁₃ = me then
          if t₁₄ = them then
            if t₁₅ = sid then
              match statepack_c₁ t₁₆ with
              | some hs =>
                match statepack_c₂ t₁₆ with
                | some cs1 =>
                  match statepack_c₃ t₁₆ with
                  | some cs2 =>
                    match handshakestatesetcs hs cs1 with
                    | some hs =>
                      match writeMessage_c me them hs (msg_c me them sid) sid with
                      | some t₁₇ =>
                        match Tuple.ofMsg (T.Msg × T.Msg) t₁₇ with
                        | some (hs, message_c) =>
                          .emit (SendMsg me them (stagepack_c sid) (msg_c me them sid))
                          match
                            handshakestategetcs hs >>= fun t₁₈ =>
                              some ((me, them, sid, statepack_d hs t₁₈ cs2) : T.Msg) with
                          | some rec₀ =>
                            if ← .fork then
                              .repl
                              .send statestore rec₀
                            else
                              .send pub' message_c
                          | none =>
                            .stop
                        | none =>
                          .stop
                      | none =>
                        .stop
                    | none =>
                      .stop
                  | none =>
                    .stop
                | none =>
                  .stop
              | none =>
                .stop
            else
              .stop
          else
            .stop
        else
          .stop
      | none =>
        .stop
    else
      .repl
      if ← .fork then
        let t₁₉ ← .recv statestore
        match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₁₉ with
        | some (t₂₀, t₂₁, t₂₂, t₂₃) =>
          if t₂₀ = me then
            if t₂₁ = them then
              if t₂₂ = sid then
                match statepack_d₁ t₂₃ with
                | some hs =>
                  match statepack_d₂ t₂₃ with
                  | some _cs1 =>
                    match statepack_d₃ t₂₃ with
                    | some cs2 =>
                      match handshakestatesetcs hs cs2 with
                      | some hs =>
                        let message_d ← .recv pub'
                        match readMessage_d me them hs message_d sid with
                        | some t₂₄ =>
                          match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₂₄ with
                          | some (_hs, plaintext_d, valid) =>
                            .emit (RecvMsg me them (stagepack_d sid) plaintext_d)
                            .emit (RecvEnd valid)
                          | none =>
                            .stop
                        | none =>
                          .stop
                      | none =>
                        .stop
                    | none =>
                      .stop
                  | none =>
                    .stop
                | none =>
                  .stop
              else
                .stop
            else
              .stop
          else
            .stop
        | none =>
          .stop
      else
        .stop

/-- `initiator` is prefix-closed. -/
theorem initiator_tree (me them sid : T.Msg) : Cont.Tree (initiator me them sid) :=
  by
  unfold initiator
  aesop  (config := { enableSimp := false, maxRuleApplicationDepth := 0, maxRuleApplications := 0 })
     (add norm (by dsimp only))

def responder (me them sid : T.Msg) : Cont (Proc T.Msg) Unit := do
  let s := keypairpack empty empty
  if ← .fork then
    if ← .fork then
      if ← .fork then
        let e := keypairpack empty empty
        let rs := empty
        let re := empty
        match initialize_responder empty s e rs re empty with
        | some hs =>
          let rec₀ := ((me, them, sid, statepack_a hs) : T.Msg)
          if ← .fork then
            .repl
            .send statestore rec₀
          else
            .stop
        | none =>
          .stop
      else
        let t₀ ← .recv statestore
        match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₀ with
        | some (t₁, t₂, t₃, t₄) =>
          if t₁ = me then
            if t₂ = them then
              if t₃ = sid then
                match statepack_a₁ t₄ with
                | some hs =>
                  let message_a ← .recv pub'
                  match readMessage_a me them hs message_a sid with
                  | some t₅ =>
                    match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₅ with
                    | some (hs, plaintext_a, _valid) =>
                      .emit (RecvMsg me them (stagepack_a sid) plaintext_a)
                      let rec₀ := ((me, them, sid, statepack_b hs) : T.Msg)
                      if ← .fork then
                        .repl
                        .send statestore rec₀
                      else
                        .stop
                    | none =>
                      .stop
                  | none =>
                    .stop
                | none =>
                  .stop
              else
                .stop
            else
              .stop
          else
            .stop
        | none =>
          .stop
    else
      let t₆ ← .recv statestore
      match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₆ with
      | some (t₇, t₈, t₉, t₁₀) =>
        if t₇ = me then
          if t₈ = them then
            if t₉ = sid then
              match statepack_b₁ t₁₀ with
              | some hs =>
                match writeMessage_b me them hs (msg_b me them sid) sid with
                | some t₁₁ =>
                  match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₁₁ with
                  | some (hs, message_b, cs1, cs2) =>
                    .emit (SendMsg me them (stagepack_b sid) (msg_b me them sid))
                    let rec₀ := ((me, them, sid, statepack_c hs cs1 cs2) : T.Msg)
                    if ← .fork then
                      .repl
                      .send statestore rec₀
                    else
                      .send pub' message_b
                  | none =>
                    .stop
                | none =>
                  .stop
              | none =>
                .stop
            else
              .stop
          else
            .stop
        else
          .stop
      | none =>
        .stop
  else
    .repl
    if ← .fork then
      let t₁₂ ← .recv statestore
      match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₁₂ with
      | some (t₁₃, t₁₄, t₁₅, t₁₆) =>
        if t₁₃ = me then
          if t₁₄ = them then
            if t₁₅ = sid then
              match statepack_c₁ t₁₆ with
              | some hs =>
                match statepack_c₂ t₁₆ with
                | some cs1 =>
                  match statepack_c₃ t₁₆ with
                  | some cs2 =>
                    match handshakestatesetcs hs cs1 with
                    | some hs =>
                      let message_c ← .recv pub'
                      match readMessage_c me them hs message_c sid with
                      | some t₁₇ =>
                        match Tuple.ofMsg (T.Msg × T.Msg × T.Msg) t₁₇ with
                        | some (hs, plaintext_c, _valid) =>
                          .emit (RecvMsg me them (stagepack_c sid) plaintext_c)
                          match
                            handshakestategetcs hs >>= fun t₁₈ =>
                              some ((me, them, sid, statepack_d hs t₁₈ cs2) : T.Msg) with
                          | some rec₀ =>
                            if ← .fork then
                              .repl
                              .send statestore rec₀
                            else
                              .stop
                          | none =>
                            .stop
                        | none =>
                          .stop
                      | none =>
                        .stop
                    | none =>
                      .stop
                  | none =>
                    .stop
                | none =>
                  .stop
              | none =>
                .stop
            else
              .stop
          else
            .stop
        else
          .stop
      | none =>
        .stop
    else
      .repl
      if ← .fork then
        let t₁₉ ← .recv statestore
        match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₁₉ with
        | some (t₂₀, t₂₁, t₂₂, t₂₃) =>
          if t₂₀ = me then
            if t₂₁ = them then
              if t₂₂ = sid then
                match statepack_d₁ t₂₃ with
                | some hs =>
                  match statepack_d₂ t₂₃ with
                  | some _cs1 =>
                    match statepack_d₃ t₂₃ with
                    | some cs2 =>
                      match handshakestatesetcs hs cs2 with
                      | some hs =>
                        match writeMessage_d me them hs (msg_d me them sid) sid with
                        | some t₂₄ =>
                          match Tuple.ofMsg (T.Msg × T.Msg) t₂₄ with
                          | some (_hs, message_d) =>
                            .emit (SendMsg me them (stagepack_d sid) (msg_d me them sid))
                            .send pub' message_d
                          | none =>
                            .stop
                        | none =>
                          .stop
                      | none =>
                        .stop
                    | none =>
                      .stop
                  | none =>
                    .stop
                | none =>
                  .stop
              else
                .stop
            else
              .stop
          else
            .stop
        | none =>
          .stop
      else
        .stop

/-- `responder` is prefix-closed. -/
theorem responder_tree (me them sid : T.Msg) : Cont.Tree (responder me them sid) :=
  by
  unfold responder
  aesop  (config := { enableSimp := false, maxRuleApplicationDepth := 0, maxRuleApplications := 0 })
     (add norm (by dsimp only), safe [initiator_tree])

def repeatingKeysQuery : Cont (Proc T.Msg) Unit := do
  if ← .fork then
    if ← .fork then
      if ← .fork then
        let t₀ ← .recv statestore
        match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₀ with
        | some (a, b, sid_x, t₁) =>
          match statepack_a₁ t₁ with
          | some hs_x =>
            let t₂ ← .recv statestore
            match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₂ with
            | some (c, d, sid_y, t₃) =>
              match statepack_a₁ t₃ with
              | some hs_y =>
                match handshakestategetcs hs_x with
                | some cs_x =>
                  match handshakestategetcs hs_y with
                  | some cs_y =>
                    match cipherstateunpack cs_x with
                    | some t₄ =>
                      match Tuple.ofMsg (T.Msg × T.Msg) t₄ with
                      | some (k_x, _n_x) =>
                        match cipherstateunpack cs_y with
                        | some t₅ =>
                          match Tuple.ofMsg (T.Msg × T.Msg) t₅ with
                          | some (k_y, _n_y) =>
                            if k_x = k_y ∧ (b ≠ c ∨ a ≠ d) ∧ (a ≠ c ∨ b ≠ d ∨ sid_x ≠ sid_y) then
                              .emit (RepeatingKey_a a)
                            else
                              .stop
                          | none =>
                            .stop
                        | none =>
                          .stop
                      | none =>
                        .stop
                    | none =>
                      .stop
                  | none =>
                    .stop
                | none =>
                  .stop
              | none =>
                .stop
            | none =>
              .stop
          | none =>
            .stop
        | none =>
          .stop
      else
        let t₆ ← .recv statestore
        match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₆ with
        | some (a, b, sid_x, t₇) =>
          match statepack_b₁ t₇ with
          | some hs_x =>
            let t₈ ← .recv statestore
            match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₈ with
            | some (c, d, sid_y, t₉) =>
              match statepack_b₁ t₉ with
              | some hs_y =>
                match handshakestategetcs hs_x with
                | some cs_x =>
                  match handshakestategetcs hs_y with
                  | some cs_y =>
                    match cipherstateunpack cs_x with
                    | some t₁₀ =>
                      match Tuple.ofMsg (T.Msg × T.Msg) t₁₀ with
                      | some (k_x, _n_x) =>
                        match cipherstateunpack cs_y with
                        | some t₁₁ =>
                          match Tuple.ofMsg (T.Msg × T.Msg) t₁₁ with
                          | some (k_y, _n_y) =>
                            if k_x = k_y ∧ (b ≠ c ∨ a ≠ d) ∧ (a ≠ c ∨ b ≠ d ∨ sid_x ≠ sid_y) then
                              .emit (RepeatingKey_b a)
                            else
                              .stop
                          | none =>
                            .stop
                        | none =>
                          .stop
                      | none =>
                        .stop
                    | none =>
                      .stop
                  | none =>
                    .stop
                | none =>
                  .stop
              | none =>
                .stop
            | none =>
              .stop
          | none =>
            .stop
        | none =>
          .stop
    else
      let t₁₂ ← .recv statestore
      match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₁₂ with
      | some (a, b, sid_x, t₁₃) =>
        match statepack_c₁ t₁₃ with
        | some _hs_x =>
          match statepack_c₂ t₁₃ with
          | some cs1_x =>
            match statepack_c₃ t₁₃ with
            | some _cs2_x =>
              let t₁₄ ← .recv statestore
              match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₁₄ with
              | some (c, d, sid_y, t₁₅) =>
                match statepack_c₁ t₁₅ with
                | some _hs_y =>
                  match statepack_c₂ t₁₅ with
                  | some cs1_y =>
                    match statepack_c₃ t₁₅ with
                    | some _cs2_y =>
                      match cipherstateunpack cs1_x with
                      | some t₁₆ =>
                        match Tuple.ofMsg (T.Msg × T.Msg) t₁₆ with
                        | some (k1_x, _n1_x) =>
                          match cipherstateunpack cs1_y with
                          | some t₁₇ =>
                            match Tuple.ofMsg (T.Msg × T.Msg) t₁₇ with
                            | some (k1_y, _n1_y) =>
                              if
                                  k1_x = k1_y ∧
                                    (b ≠ c ∨ a ≠ d) ∧ (a ≠ c ∨ b ≠ d ∨ sid_x ≠ sid_y) then

                                .emit (RepeatingKey_c a)
                              else
                                .stop
                            | none =>
                              .stop
                          | none =>
                            .stop
                        | none =>
                          .stop
                      | none =>
                        .stop
                    | none =>
                      .stop
                  | none =>
                    .stop
                | none =>
                  .stop
              | none =>
                .stop
            | none =>
              .stop
          | none =>
            .stop
        | none =>
          .stop
      | none =>
        .stop
  else
    let t₁₈ ← .recv statestore
    match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₁₈ with
    | some (a, b, sid_x, t₁₉) =>
      match statepack_d₁ t₁₉ with
      | some _hs_x =>
        match statepack_d₂ t₁₉ with
        | some _cs1_x =>
          match statepack_d₃ t₁₉ with
          | some cs2_x =>
            let t₂₀ ← .recv statestore
            match Tuple.ofMsg (T.Msg × T.Msg × T.Msg × T.Msg) t₂₀ with
            | some (c, d, sid_y, t₂₁) =>
              match statepack_d₁ t₂₁ with
              | some _hs_y =>
                match statepack_d₂ t₂₁ with
                | some _cs1_y =>
                  match statepack_d₃ t₂₁ with
                  | some cs2_y =>
                    match cipherstateunpack cs2_x with
                    | some t₂₂ =>
                      match Tuple.ofMsg (T.Msg × T.Msg) t₂₂ with
                      | some (k2_x, _n2_x) =>
                        match cipherstateunpack cs2_y with
                        | some t₂₃ =>
                          match Tuple.ofMsg (T.Msg × T.Msg) t₂₃ with
                          | some (k2_y, _n2_y) =>
                            if k2_x = k2_y ∧ (b ≠ c ∨ a ≠ d) ∧ (a ≠ c ∨ b ≠ d ∨ sid_x ≠ sid_y) then
                              .emit (RepeatingKey_d a)
                            else
                              .stop
                          | none =>
                            .stop
                        | none =>
                          .stop
                      | none =>
                        .stop
                    | none =>
                      .stop
                  | none =>
                    .stop
                | none =>
                  .stop
              | none =>
                .stop
            | none =>
              .stop
          | none =>
            .stop
        | none =>
          .stop
      | none =>
        .stop
    | none =>
      .stop

/-- `repeatingKeysQuery` is prefix-closed. -/
theorem repeatingKeysQuery_tree : Cont.Tree repeatingKeysQuery :=
  by
  unfold repeatingKeysQuery
  aesop  (config := { enableSimp := false, maxRuleApplicationDepth := 0, maxRuleApplications := 0 })
     (add norm (by dsimp only), safe [initiator_tree, responder_tree])

/-- The main process. -/
def system : Proc T.Msg :=
  .run do
    .send pub' (key_s charlie)
    .repl
    let sid ← .fresh
    if ← .fork then
      if ← .fork then
        if ← .fork then
          initiator alice bob sid
        else
          initiator alice charlie sid
      else
        responder bob alice sid
    else
      responder bob charlie sid

/-- The main process is prefix-closed. -/
theorem system_mem_tree : system ∈ Descriptive.tree (Act T.Msg) :=
  by
  unfold system
  exact
    Cont.Tree.run
      (by
        aesop
           (config :=
            { enableSimp := false, maxRuleApplicationDepth := 0, maxRuleApplications := 0 })
           (add norm (by dsimp only),
            safe [initiator_tree, responder_tree, repeatingKeysQuery_tree]))

/-! ## Queries -/

/-- The variables of `query c, m, sid_a, sid_b, s, b, px, py, pz; event(RecvMsg(bob, alice, stagepack_a(sid_b), m)) ==> event(SendMsg(alice, bob, stagepack_a(sid_a), m))`. -/
inductive Vars₁
  | c
  | m
  | sid_a
  | sid_b
  | s
  | b
  | px
  | py
  | pz

/-- `query c, m, sid_a, sid_b, s, b, px, py, pz; event(RecvMsg(bob, alice, stagepack_a(sid_b), m)) ==> event(SendMsg(alice, bob, stagepack_a(sid_a), m))` -/
def query₁ : Prop :=
  system.Corr
    (fun σ : Vars₁ → T.Msg => Fact.event (RecvMsg bob alice (stagepack_a (σ .sid_b)) (σ .m)))
    fun σ => Fact.event (SendMsg alice bob (stagepack_a (σ .sid_a)) (σ .m))

/-- The variables of `query c, m, sid_a, sid_b, s, b, px, py, pz; event(RecvMsg(bob, alice, stagepack_a(sid_b), m)) ==> event(SendMsg(alice, c, stagepack_a(sid_a), m)) || (false || false)`. -/
inductive Vars₂
  | c
  | m
  | sid_a
  | sid_b
  | s
  | b
  | px
  | py
  | pz

/-- `query c, m, sid_a, sid_b, s, b, px, py, pz; event(RecvMsg(bob, alice, stagepack_a(sid_b), m)) ==> event(SendMsg(alice, c, stagepack_a(sid_a), m)) || (false || false)` -/
def query₂ : Prop :=
  system.Satisfies (X := Vars₂)
    ⟨[(false, fun σ => QFact.event (RecvMsg bob alice (stagepack_a (σ .sid_b)) (σ .m)))],
      .or (.fact false fun σ => QFact.event (SendMsg alice (σ .c) (stagepack_a (σ .sid_a)) (σ .m)))
        (.or .false .false)⟩

/-- The variables of `query c, m, sid_a, sid_b, s, b, px, py, pz; event(RecvMsg(bob, alice, stagepack_a(sid_b), m)) ==> event(SendMsg(alice, c, stagepack_a(sid_a), m)) || false`. -/
inductive Vars₃
  | c
  | m
  | sid_a
  | sid_b
  | s
  | b
  | px
  | py
  | pz

/-- `query c, m, sid_a, sid_b, s, b, px, py, pz; event(RecvMsg(bob, alice, stagepack_a(sid_b), m)) ==> event(SendMsg(alice, c, stagepack_a(sid_a), m)) || false` -/
def query₃ : Prop :=
  system.Satisfies (X := Vars₃)
    ⟨[(false, fun σ => QFact.event (RecvMsg bob alice (stagepack_a (σ .sid_b)) (σ .m)))],
      .or (.fact false fun σ => QFact.event (SendMsg alice (σ .c) (stagepack_a (σ .sid_a)) (σ .m)))
        .false⟩

/-- The variables of `query c, m, sid_a, sid_b, s, b, px, py, pz; event(RecvMsg(bob, alice, stagepack_a(sid_b), m)) ==> event(SendMsg(alice, bob, stagepack_a(sid_a), m)) || (false || false)`. -/
inductive Vars₄
  | c
  | m
  | sid_a
  | sid_b
  | s
  | b
  | px
  | py
  | pz

/-- `query c, m, sid_a, sid_b, s, b, px, py, pz; event(RecvMsg(bob, alice, stagepack_a(sid_b), m)) ==> event(SendMsg(alice, bob, stagepack_a(sid_a), m)) || (false || false)` -/
def query₄ : Prop :=
