theorem keypairunpack_eq_some {x₀ m₀ : T.Msg} :
    keypairunpack x₀ = some m₀ ↔
      ∃ public_key,
        ∃ private_key,
          x₀ = keypairpack public_key private_key ∧ m₀ = ((public_key, private_key) : T.Msg) :=
  ⟨fun h₀ =>
    by
    rcases hv₀ : x₀.view with _ | ⟨f₀, a₀⟩ | _ <;> simp [keypairunpack, hv₀] at h₀
    rcases f₀ with f₀ | f₀ <;> cases f₀ <;> try simp at h₀
    subst h₀
    have e₀ : x₀ = keypairpack (a₀ 0) (a₀ 1) :=
      x₀.eq_app_of_view' hv₀
        (by
          intro i₀
          fin_cases i₀
          · exact rfl
          · exact rfl)
    exact ⟨a₀ 0, a₀ 1, e₀, rfl⟩, fun h₀ =>
    by
    rcases h₀ with ⟨public_key, private_key, rfl, rfl⟩
    simp [keypairunpack, keypairpack, free]⟩

