/-- `query c, m, sid_a, sid_b, s, b, px, py, pz; attacker(msg_a(alice, bob, sid_a)) ==> event(LeakS(phase0, bob)) || (event(LeakS(px, bob)) && event(LeakS(pz, alice)))` -/
def query₈ : Prop :=
