(* The rest of the fragment, on a one-message protocol: destructors with several
   rules and with may-fail arguments (the manual's eq, test and catchfail,
   §4.2.1), a destructor declared with `;` whose rules overlap and agree, which
   the determinism check accepts, a type converter, a private channel and private constructors, a
   conditional, a destructor in an output, else branches, events, queries with
   variables, queries that a fact never holds, a query whose conclusion is a
   disjunction of conjunctions, a conjunction before the arrow, an injective
   correspondence, a nested one, `mess` and `table` facts, facts qualified by a
   phase, an equality and a disequality after the arrow, a `let` binding in a
   query and a reference `new n` to a bound name, the secrecy of a bound name,
   a phase in which the key is leaked, a table, compiled to a private channel,
   macros with a parameter that may fail (§4.2.3, §4.2.4), the
   sugar `x <- D;`, the wildcard `_`, an equality test with a destructor in an
   input's pattern, and terms with effects (§4.1.4):
   function macros that create a name and emit an event, a conditional term whose
   condition may fail, an event in an argument after a sibling that fails, a
   restriction and a term evaluation inside an output, and calls of a function
   and of a process macro whose first argument fails before the second emits an
   event; a free name, T, and a process macro, forward, whose names the
   translation uses, so that they are renamed; and tuples and booleans: a
   tuple as a message, in a rewrite rule and in a query, tuple patterns with an
   equality test in an input and a term evaluation, a pattern on a data
   constructor, the booleans as values, and conditions with the connectives,
   with and without a destructor in them. *)

type key.
type nonce.

channel c.
free d : channel [private].
free T : bitstring.

const empty : bitstring [data].
const yes, no : bool.

fun pair(bitstring, bitstring) : bitstring [data].
fun senc(bitstring, key) : bitstring.
reduc forall x : bitstring, k : key; sdec(senc(x, k), k) = x.

fun eq(bitstring, bitstring) : bool
  reduc forall x : bitstring; eq(x, x) = yes
  otherwise forall x : bitstring, y : bitstring; eq(x, y) = no.

fun test(bool, bitstring, bitstring) : bitstring
  reduc forall x : bitstring, y : bitstring; test(yes, x, y) = x
  otherwise forall b : bool or fail, x : bitstring, y : bitstring; test(b, x, y) = y.

fun catchfail(bitstring) : bitstring
  reduc forall x : bitstring; catchfail(x) = x
  otherwise catchfail(fail) = empty.

fun n2b(nonce) : bitstring [typeConverter].
fun tag(nonce) : bitstring [private].

reduc forall x : bitstring, y : bitstring; unpair(pair(x, y)) = (x, y).
reduc forall x : bitstring; left(pair(x, empty)) = x;
      forall y : bitstring; left(pair(empty, y)) = y.

event Sent(nonce).
event Received(nonce).
event Stamped(bitstring).

table seen(nonce).

query n : nonce; event(Received(n)) ==> event(Sent(n)).
query n : nonce; event(Received(n)) ==> event(Sent(n)) || (event(Sent(n)) && attacker(tag(n))).
query n : nonce; attacker(tag(n)) ==> event(Sent(n)).
query attacker(empty).
query n : nonce; (attacker(tag(n))) ==> (false).
query n : nonce; event(Sent(n)).
query x : bitstring; event(Stamped(x)) ==> attacker(x).
query attacker((empty, T)).
query n : nonce; attacker(tag(n)) phase 0.
query n : nonce; mess(d, tag(n)).
query n : nonce; mess(c, tag(n)) phase 1.
query n : nonce; table(seen(n)) ==> event(Sent(n)).
query n : nonce; inj-event(Received(n)) ==> inj-event(Sent(n)).
query n : nonce; attacker(tag(n)) ==> inj-event(Sent(n)).
query n : nonce; event(Received(n)) ==> (event(Sent(n)) ==> event(Stamped(n2b(n)))).
query n : nonce; event(Received(n)) && event(Sent(n)) ==> attacker(tag(n)) phase 0 || event(Stamped(n2b(n))).
query x : bitstring; event(Stamped(x)) ==> x <> empty.
query x : bitstring, n : nonce; event(Stamped(x)) ==> (x = n2b(n) && event(Sent(n))) || attacker(x).
query n : nonce; let m = n2b(n) in event(Stamped(m)) ==> event(Sent(n)).
query attacker(tag(new n)).
query let x = new n in event(Sent(x)) ==> attacker(n2b(x)) || attacker(tag(x)).
query secret k.

letfun stamp(x : bitstring) = event Stamped(x); x.
letfun wrap(x : bitstring, k : key) = new r : nonce; senc(pair(x, n2b(r)), k).
letfun both(x : bitstring, y : bitstring) = pair(x, y).
letfun recover(x : bitstring or fail) = let y = x in y else empty.

let forward(x : bitstring, y : bitstring) = out(c, pair(x, y)).
let guard(x : bitstring or fail, k : key) = let y = x in out(c, senc(y, k)) else out(c, empty).

let sender(k : key) =
  new n : nonce;
  event Sent(n);
  insert seen(n);
  let m = senc(n2b(n), k) in
  out(c, m);
  out(d, tag(n)).

let receiver(k : key) =
  in(c, x : bitstring);
  let n = sdec(x, k) in
    event Received(n)
  else
    out(c, pair(empty, T)).

let relay(k : key) =
  in(c, y : bitstring);
  let z = (if sdec(y, k) = empty then stamp(y) else wrap(y, k)) in
    out(c, z)
  else
    let w = pair(sdec(y, k), stamp(y)) in out(c, w) else out(c, y).

let reader(k : key) =
  get seen(x : nonce) in
  out(d, tag(x));
  in(c, (_ : bitstring, z2 : bitstring, =sdec(x, k)));
  z3 <- pair(z2, z2);
  out(c, z3).

let tupler(k : key) =
  in(c, (x : bitstring, =empty));
  let (a : bitstring, b : bitstring) = unpair(x) in
    (let pair(a' : bitstring, b' : bitstring) = pair(b, a) in
     let flag = (a = a') in
     if flag && not(b = empty) || true then
       out(c, (a', b', flag))
     else
       out(c, ()))
  else
    if sdec(x, k) = empty && x = x then out(c, (x = x)) else 0.

process
  new k : key;
  ( (!sender(k))
  | (!receiver(k))
  | (!relay(k))
  | (!tupler(k))
  | (in(d, y : bitstring);
     if catchfail(test(eq(y, empty), y, empty)) <> empty then out(c, y) else 0)
  | (in(c, z : bitstring); out(c, sdec(z, k)); reader(k))
  | (in(c, w : bitstring); out(c, both(sdec(w, k), stamp(w))); forward(sdec(w, k), stamp(w)))
  | (out(c, new s : nonce; let v = wrap(n2b(s), k) in pair(v, stamp(v))))
  | (in(c, u : bitstring); out(c, recover(sdec(u, k))); guard(sdec(u, k), k))
  | (phase 1; out(c, k)) )
