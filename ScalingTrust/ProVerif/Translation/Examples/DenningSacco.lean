/-- The constructors, by arity: the free names, the declared constructors and the events. -/
inductive Fun : ℕ → Type
  | const (a : Free) : Fun 0
  | g : Fun 0
  | pk : Fun 1
  | hash : Fun 1
  | senc : Fun 2
  | aenc : Fun 2
  | sign : Fun 2
  | exp : Fun 2

/-- The equations: `exp(exp(g, x), y) = exp(exp(g, y), x)`. -/
def E : Set (Term Fun × Term Fun) :=
  {(.func .exp ![.func .exp ![.func .g ![], .var 0], .var 1],
      .func .exp ![.func .exp ![.func .g ![], .var 1], .var 0])}

/-- The free symbols: those at the root of no equation. -/
def free : ∀ n, Fun n → Bool
  | _, .exp => false
  | _, _ => true

