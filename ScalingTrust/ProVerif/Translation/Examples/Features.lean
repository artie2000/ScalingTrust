    catchfail u₀ = some m₀ ↔ u₀ = some m₀ ∨ (¬∃ x, u₀ = some x) ∧ u₀ = none ∧ m₀ = empty :=
  ⟨fun h₀ => by
    rw [catchfail.eq_def, join_eq_some, orElse_eq_some] at h₀
    rcases h₀ with h₀ | ⟨n₀, h₀⟩
    · refine Or.inl ?_
      rcases u₀ with _ | x₀ <;> simp at h₀
      subst h₀
      exact rfl
