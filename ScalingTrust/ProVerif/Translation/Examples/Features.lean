def pair (x₀ x₁ : T.Msg) : T.Msg :=
  .app (.inl .pair) ![x₀, x₁]

def senc (x₀ x₁ : T.Msg) : T.Msg :=
  .app (.inl .senc) ![x₀, x₁]

def tag (x₀ : T.Msg) : T.Msg :=
  .app (.inl .tag) ![x₀]

/-! ## Events -/

def Sent (x₀ : T.Msg) : T.Msg :=
  .app (.inl .Sent) ![x₀]

def Received (x₀ : T.Msg) : T.Msg :=
  .app (.inl .Received) ![x₀]

