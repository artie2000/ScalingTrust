      · intro hm₀
        rcases hm₀ with ⟨x, rfl⟩
        simp at n₀
      · rcases u₀ with _ | _ <;> simp at h₀
        subst h₀
        exact ⟨rfl, rfl⟩, fun h₀ =>
    by
    have r₀ :
      ∀ o,
        (match u₀ with
            | some x₀ => some (some x₀)
            | none => none) =
            some o →
          ∃ x, u₀ = some x :=
      fun o₀ ho₀ => by
      rcases u₀ with _ | x₀ <;> simp at ho₀
      exact ⟨x₀, rfl⟩
