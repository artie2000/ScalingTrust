/-- The constructors, by arity: the free names, the declared constructors and the events. -/
inductive Fun : ℕ → Type
  | const (a : Free) : Fun 0
  | empty : Fun 0
  | yes : Fun 0
  | no : Fun 0
  | senc : Fun 2
  | n2b : Fun 1
  | tag : Fun 1
  | Sent : Fun 1
  | Received : Fun 1

/-- No equations. -/
def E : Set (Term Fun × Term Fun) :=
  ∅

/-- The free symbols: those at the root of no equation. -/
def free : ∀ n, Fun n → Bool := fun _ _ => true

/-- The theory. -/
def T : Theory Fun where
