namespace Features

open ProVerif.TraceSemantics Classical

/-- The free names. -/
inductive Free
  | c
  | d

/-- The constructors, by arity: the free names, the declared constructors and the events. -/
inductive Fun : ℕ → Type
  | const (a : Free) : Fun 0
  | empty : Fun 0
  | yes : Fun 0
  | no : Fun 0
  | senc : Fun 2
  | n2b : Fun 1
  | tag : Fun 1
  | Sent : Fun 1
  | Received : Fun 1

/-- No equations. -/
def E : Set (Term Fun × Term Fun) :=
  ∅

/-- The free symbols: those at the root of no equation. -/
def free : ∀ n, Fun n → Bool := fun _ _ => true

/-- The theory. -/
def T : Theory Fun where
  E := E
  free := free
  heads := by simp [E]

@[simp]
theorem free_eq {n : ℕ} (f : Fun n) : T.free n f = free n f :=
  rfl

/-! ## Constructors -/

def c : T.Msg :=
  .app (.const .c) ![]

def d : T.Msg :=
  .app (.const .d) ![]

def empty : T.Msg :=
  .app .empty ![]

def yes : T.Msg :=
  .app .yes ![]

def no : T.Msg :=
  .app .no ![]

def senc (x₀ x₁ : T.Msg) : T.Msg :=
  .app .senc ![x₀, x₁]

def tag (x₀ : T.Msg) : T.Msg :=
  .app .tag ![x₀]

/-! ## Events -/

def Sent (x₀ : T.Msg) : T.Msg :=
  .app .Sent ![x₀]

def Received (x₀ : T.Msg) : T.Msg :=
  .app .Received ![x₀]

/-! ## Destructors -/

/-- `sdec(senc(x, k), k) → x` -/
def sdec (x₀ x₁ : T.Msg) : Option T.Msg :=
  match x₀.view with
  | .app .senc a₀ => if a₀ 1 = x₁ then some (a₀ 0) else none
  | _ => none

/-- `eq(x, x) → yes; eq(x, y) → no` -/
def eq (x₀ x₁ : T.Msg) : Option T.Msg :=
  Option.join ((if x₁ = x₀ then some (some yes) else none) <|> some (some no))

/-- `test(yes, x, y) → x; test(b, x, y) → y` -/
def test (u₀ u₁ u₂ : Option T.Msg) : Option T.Msg :=
  Option.join
    ((match u₀ with
      | some x₀ =>
        match u₁ with
        | some x₁ =>
          match u₂ with
          | some _ => if x₀ = yes then some (some x₁) else none
          | none => none
        | none => none
      | none => none) <|>
      match u₁ with
      | some _ =>
        match u₂ with
        | some x₂ => some (some x₂)
        | none => none
      | none => none)

/-- `catchfail(x) → x; catchfail(fail) → empty` -/
def catchfail (u₀ : Option T.Msg) : Option T.Msg :=
  Option.join
    ((match u₀ with
      | some x₀ => some (some x₀)
      | none => none) <|>
      match u₀ with
      | none => some (some empty)
      | some _ => none)

/-! ### The destructors' graphs are their rules -/

theorem sdec_eq_some {x₀ x₁ m₀ : T.Msg} : sdec x₀ x₁ = some m₀ ↔ x₀ = senc m₀ x₁ :=
  ⟨fun h₀ => by
    rcases hv₀ : x₀.view with _ | ⟨f₀, a₀⟩ | _ <;> simp [sdec, hv₀] at h₀
    cases f₀ <;> try simp at h₀
    rcases h₀ with ⟨h₁, h₂⟩
    subst h₂
    have e₀ : x₀ = senc (a₀ 0) x₁ :=
      x₀.eq_app_of_view' hv₀
        (by
          intro i₀
          fin_cases i₀
          · exact rfl
          · exact h₁)
    exact e₀, fun h₀ => by
    rcases h₀ with rfl
    simp [sdec, senc, free]⟩

theorem eq_eq_some {x₀ x₁ m₀ : T.Msg} :
    eq x₀ x₁ = some m₀ ↔ x₁ = x₀ ∧ m₀ = yes ∨ ¬x₁ = x₀ ∧ m₀ = no :=
  ⟨fun h₀ => by
    rw [eq.eq_def, join_eq_some, orElse_eq_some] at h₀
    rcases h₀ with h₀ | ⟨n₀, h₀⟩
    · refine Or.inl ?_
      simp at h₀
      rcases h₀ with ⟨h₁, h₂⟩
      subst h₂
      exact ⟨h₁, rfl⟩
    · refine Or.inr ⟨?_, ?_⟩
      · intro hm₀
        rcases hm₀ with rfl
        simp at n₀
      · simp at h₀
        subst h₀
        exact rfl, fun h₀ =>
    by
    have r₀ : ∀ o, (if x₁ = x₀ then some (some yes) else none) = some o → x₁ = x₀ := fun o₀ ho₀ =>
      by
      simp at ho₀
      rcases ho₀ with ⟨h₁, -⟩
      exact h₁
    rcases h₀ with d₀ | (d₁)
    · rcases d₀ with ⟨rfl, rfl⟩
      rw [eq.eq_def, join_eq_some, orElse_eq_some]
      refine Or.inl ?_
      simp
    · rcases d₁ with ⟨n₀, rfl⟩
      rw [eq.eq_def, join_eq_some, orElse_eq_some]
      refine Or.inr ⟨?_, ?_⟩
      · by_contra hne₀
        obtain ⟨o₀, ho₀⟩ := Option.ne_none_iff_exists'.1 hne₀
        exact n₀ (r₀ o₀ ho₀)
      · simp⟩

theorem test_eq_some {u₀ u₁ u₂ : Option T.Msg} {m₀ : T.Msg} :
    test u₀ u₁ u₂ = some m₀ ↔
      (∃ y, u₀ = some yes ∧ u₁ = some m₀ ∧ u₂ = some y) ∨
        (¬∃ x, ∃ y, u₀ = some yes ∧ u₁ = some x ∧ u₂ = some y) ∧ ∃ x, u₁ = some x ∧ u₂ = some m₀ :=
  ⟨fun h₀ => by
    rw [test.eq_def, join_eq_some, orElse_eq_some] at h₀
    rcases h₀ with h₀ | ⟨n₀, h₀⟩
    · refine Or.inl ?_
      rcases u₀ with _ | x₀ <;> simp at h₀
      rcases u₁ with _ | x₁ <;> simp at h₀
      rcases u₂ with _ | x₂ <;> simp at h₀
      rcases h₀ with ⟨h₁, h₂⟩
      subst h₂
      exact ⟨x₂, congrArg some h₁, rfl, rfl⟩
    · refine Or.inr ⟨?_, ?_⟩
      · intro hm₀
        rcases hm₀ with ⟨x, y, rfl, rfl, rfl⟩
        simp [yes] at n₀
      · rcases u₁ with _ | x₁ <;> simp at h₀
        rcases u₂ with _ | x₂ <;> simp at h₀
        subst h₀
        exact ⟨x₁, rfl, rfl⟩, fun h₀ =>
    by
    have r₀ :
      ∀ o,
        (match u₀ with
            | some x₀ =>
              match u₁ with
              | some x₁ =>
                match u₂ with
                | some _ => if x₀ = yes then some (some x₁) else none
                | none => none
              | none => none
            | none => none) =
            some o →
          ∃ x, ∃ y, u₀ = some yes ∧ u₁ = some x ∧ u₂ = some y :=
      fun o₀ ho₀ => by
      rcases u₀ with _ | x₀ <;> simp at ho₀
      rcases u₁ with _ | x₁ <;> simp at ho₀
      rcases u₂ with _ | x₂ <;> simp at ho₀
      rcases ho₀ with ⟨h₁, -⟩
      exact ⟨x₁, x₂, congrArg some h₁, rfl, rfl⟩
