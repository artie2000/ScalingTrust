    · rcases d₀ with ⟨y, rfl, rfl, rfl⟩
      rw [test.eq_def, join_eq_some, orElse_eq_some]
      refine Or.inl ?_
      simp [yes]
    · rcases d₁ with ⟨n₀, x, rfl, rfl⟩
      rw [test.eq_def, join_eq_some, orElse_eq_some]
      refine Or.inr ⟨?_, ?_⟩
      · by_contra hne₀
        obtain ⟨o₀, ho₀⟩ := Option.ne_none_iff_exists'.1 hne₀
        exact n₀ (r₀ o₀ ho₀)
      · simp⟩

