  Option.join
    ((match u₀ with
      | some x₀ =>
        match u₁ with
        | some x₁ =>
          match u₂ with
          | some _ => if x₀ = yes then some (some x₁) else none
          | none => none
        | none => none
      | none => none) <|>
      match u₁ with
      | some _ =>
        match u₂ with
        | some x₂ => some (some x₂)
        | none => none
      | none => none)

/-- `catchfail(x) → x; catchfail(fail) → empty` -/
