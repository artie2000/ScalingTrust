/-! ## Constructors -/

def c : T.Msg :=
  .app (.const .c) ![]

def d : T.Msg :=
  .app (.const .d) ![]

def empty : T.Msg :=
  .app .empty ![]

def yes : T.Msg :=
  .app .yes ![]

def no : T.Msg :=
  .app .no ![]

def senc (x₀ x₁ : T.Msg) : T.Msg :=
  .app .senc ![x₀, x₁]

def tag (x₀ : T.Msg) : T.Msg :=
  .app .tag ![x₀]

/-! ## Events -/

def Sent (x₀ : T.Msg) : T.Msg :=
  .app .Sent ![x₀]

def Received (x₀ : T.Msg) : T.Msg :=
  .app .Received ![x₀]

/-! ## Destructors -/

/-- `sdec(senc(x, k), k) → x` -/
def sdec (x₀ x₁ : T.Msg) : Option T.Msg :=
  match x₀.view with
  | .app .senc a₀ => if a₀ 1 = x₁ then some (a₀ 0) else none
  | _ => none

/-- `eq(x, x) → yes; eq(x, y) → no` -/
def eq (x₀ x₁ : T.Msg) : Option T.Msg :=
  Option.join ((if x₁ = x₀ then some (some yes) else none) <|> some (some no))

/-- `test(yes, x, y) → x; test(b, x, y) → y` -/
def test (u₀ u₁ u₂ : Option T.Msg) : Option T.Msg :=
  Option.join
    ((match u₀ with
      | some x₀ =>
        match u₁ with
        | some x₁ =>
          match u₂ with
          | some _ => if x₀ = yes then some (some x₁) else none
          | none => none
        | none => none
      | none => none) <|>
      match u₁ with
      | some _ =>
        match u₂ with
        | some x₂ => some (some x₂)
        | none => none
      | none => none)

/-- `catchfail(x) → x; catchfail(fail) → empty` -/
def catchfail (u₀ : Option T.Msg) : Option T.Msg :=
  Option.join
    ((match u₀ with
      | some x₀ => some (some x₀)
      | none => none) <|>
      match u₀ with
      | none => some (some empty)
      | some _ => none)

/-! ## The message algebra -/

/-- The public symbols: all but the private free names and constructors, and the events. -/
def pub : ∀ n, Fun n → Prop
  | _, .const .d => False
  | _, .tag => False
  | _, .Sent => False
  | _, .Received => False
  | _, _ => True

/-- The public constructors, including the public free names, and the public destructors. -/
abbrev alg : MsgAlgebra Fun where
  toTheory := T
  pubFun := fun n => {f | pub n f}
  pubDtors :=
    {⟨2, liftFail fun a => sdec (a 0) (a 1)⟩, ⟨2, liftFail fun a => eq (a 0) (a 1)⟩,
      ⟨3, fun a => test (a 0) (a 1) (a 2)⟩, ⟨1, fun a => catchfail (a 0)⟩}

/-! ## The process -/

def sender (k : T.Msg) : Cont (Proc T.Msg) Unit := do
  let n ← .fresh
  .emit (Sent n)
  let m := senc n k
  .send c m
  .send d (tag n)

def receiver (k : T.Msg) : Cont (Proc T.Msg) Unit := do
  let x ← .recv c
  match sdec x k with
  | some n =>
    .emit (Received n)
  | none =>
    .send c empty

/-- The main process. -/
def system : Proc T.Msg :=
  .run
    (do
      let k ← .fresh
      if ← .fork then
        if ← .fork then
          if ← .fork then
            .repl
            sender k
          else
            .repl
            receiver k
        else
          let y ← .recv d
          match catchfail (test (eq y empty) (some y) (some empty)) with
          | some t₀ =>
            if t₀ ≠ empty then
              .send c y
            else
              .stop
          | none =>
            .stop
      else
        let z ← .recv c
        match sdec z k with
        | some t₁ =>
          .send c t₁
        | none =>
          .stop)

/-! ## Queries -/

/-- The variables of `query n; event(Received(n)) ==> event(Sent(n))`. -/
inductive Vars₁
  | n

/-- `query n; event(Received(n)) ==> event(Sent(n))` -/
def query₁ : Prop :=
  system.Corr alg.derive (fun σ : Vars₁ → T.Msg => Fact.event (Received (σ .n))) fun σ =>
    Fact.event (Sent (σ .n))

/-- The variables of `query n; attacker(tag(n)) ==> event(Sent(n))`. -/
inductive Vars₂
  | n

/-- `query n; attacker(tag(n)) ==> event(Sent(n))` -/
def query₂ : Prop :=
  system.Corr alg.derive (fun σ : Vars₂ → T.Msg => Fact.knows (tag (σ .n))) fun σ =>
    Fact.event (Sent (σ .n))

/-- `query attacker(empty)` -/
def query₃ : Prop :=
  system.Secret alg.derive empty

