/-- The equations: `x^y^z = x^z^y; kdf(x, y) = kdf(y, x)`. -/
def E : Set (Term Fun × Term Fun) :=
  {(.func .exp ![.func .exp ![.var 0, .var 1], .var 2],
      .func .exp ![.func .exp ![.var 0, .var 2], .var 1]),
    (.func .kdf ![.var 0, .var 1], .func .kdf ![.var 1, .var 0])}

/-- The free symbols: those at the root of no equation. -/
def free : ∀ n, Fun n → Bool
  | _, .exp => false
  | _, .kdf => false
  | _, _ => true

/-- The theory of the declarations. -/
def T₀ : Theory Fun where
  E := E
  free := free
  heads := by simp [E, Term.Rigid, free]

/-- The theory, with the data symbols: its messages are those of the model. -/
