/-! ## The equations, on messages -/

/-- `x^y^z = x^z^y` -/
theorem equation₁ (x y z : T.Msg) : exp (exp x y) z = exp (exp x z) y :=
  by
  have h₀ :=
    T₀.withData_satisfies
      (.func .exp ![.func .exp ![.var 0, .var 1], .var 2],
        .func .exp ![.func .exp ![.var 0, .var 2], .var 1])
      (by simp [T₀, E]) fun n₀ =>
      if n₀ = 0 then x else if n₀ = 1 then y else if n₀ = 2 then z else x
  simp only [Term.realize_func_comp, comp_vecCons, comp_vecEmpty,
    FirstOrder.Language.Term.realize_var] at h₀
  simpa [exp] using h₀

/-- `kdf(x, y) = kdf(y, x)` -/
theorem equation₂ (x y : T.Msg) : kdf x y = kdf y x :=
  by
  have h₀ :=
    T₀.withData_satisfies (.func .kdf ![.var 0, .var 1], .func .kdf ![.var 1, .var 0])
      (by simp [T₀, E]) fun n₀ => if n₀ = 0 then x else if n₀ = 1 then y else x
  simp only [Term.realize_func_comp, comp_vecCons, comp_vecEmpty,
    FirstOrder.Language.Term.realize_var] at h₀
  simpa [kdf] using h₀

/-! ## Destructors -/

/-- `verify(sign(m, sk), m, pk(sk)) → true` -/
def verify (x₀ x₁ x₂ : T.Msg) : Option T.Msg :=
  match x₀.view with
  | .app (.inl .sign) a₀ => if a₀ 0 = x₁ ∧ x₂ = pk (a₀ 1) then some (true : T.Msg) else none
  | _ => none

/-- `sdec(senc(m, k), k) → m` -/
def sdec (x₀ x₁ : T.Msg) : Option T.Msg :=
  match x₀.view with
  | .app (.inl .senc) a₀ => if a₀ 1 = x₁ then some (a₀ 0) else none
  | _ => none

/-- `unwrap(wrap(m, k), k) → m` -/
def unwrap (x₀ x₁ : T.Msg) : Option T.Msg :=
  match x₀.view with
  | .app (.inl .wrap) a₀ => if a₀ 1 = x₁ then some (a₀ 0) else none
  | _ => none

/-- `fst(<x, y>) → x`: the first projection of the pairs, the 2-tuples. -/
def fst (x₀ : T.Msg) : Option T.Msg :=
  (Tuple.ofMsg (T.Msg × T.Msg) x₀).map Prod.fst

/-- `snd(<x, y>) → y`: the second projection of the pairs, the 2-tuples. -/
def snd (x₀ : T.Msg) : Option T.Msg :=
  (Tuple.ofMsg (T.Msg × T.Msg) x₀).map Prod.snd

/-! ### The destructors' graphs are their rules -/

theorem verify_eq_some {x₀ x₁ x₂ m₀ : T.Msg} :
    verify x₀ x₁ x₂ = some m₀ ↔ ∃ sk, x₀ = sign x₁ sk ∧ x₂ = pk sk ∧ m₀ = (true : T.Msg) :=
  ⟨fun h₀ => by
    rcases hv₀ : x₀.view with _ | ⟨f₀, a₀⟩ | _ <;> simp [verify, hv₀] at h₀
    rcases f₀ with f₀ | f₀ <;> cases f₀ <;> try simp at h₀
    rcases h₀ with ⟨⟨h₁, h₂⟩, h₃⟩
    subst h₃
    have e₀ : x₀ = sign x₁ (a₀ 1) :=
      x₀.eq_app_of_view' hv₀
        (by
          intro i₀
          fin_cases i₀
          · exact h₁
          · exact rfl)
    exact ⟨a₀ 1, e₀, h₂, rfl⟩, fun h₀ =>
    by
    rcases h₀ with ⟨sk, rfl, rfl, rfl⟩
    simp [verify, sign, pk, free]⟩

theorem sdec_eq_some {x₀ x₁ m₀ : T.Msg} : sdec x₀ x₁ = some m₀ ↔ x₀ = senc m₀ x₁ :=
  ⟨fun h₀ => by
    rcases hv₀ : x₀.view with _ | ⟨f₀, a₀⟩ | _ <;> simp [sdec, hv₀] at h₀
    rcases f₀ with f₀ | f₀ <;> cases f₀ <;> try simp at h₀
    rcases h₀ with ⟨h₁, h₂⟩
    subst h₂
    have e₀ : x₀ = senc (a₀ 0) x₁ :=
      x₀.eq_app_of_view' hv₀
        (by
          intro i₀
          fin_cases i₀
          · exact rfl
          · exact h₁)
    exact e₀, fun h₀ => by
    rcases h₀ with rfl
    simp [sdec, senc, free]⟩

theorem unwrap_eq_some {x₀ x₁ m₀ : T.Msg} : unwrap x₀ x₁ = some m₀ ↔ x₀ = wrap m₀ x₁ :=
  ⟨fun h₀ => by
    rcases hv₀ : x₀.view with _ | ⟨f₀, a₀⟩ | _ <;> simp [unwrap, hv₀] at h₀
    rcases f₀ with f₀ | f₀ <;> cases f₀ <;> try simp at h₀
    rcases h₀ with ⟨h₁, h₂⟩
    subst h₂
    have e₀ : x₀ = wrap (a₀ 0) x₁ :=
      x₀.eq_app_of_view' hv₀
        (by
          intro i₀
          fin_cases i₀
          · exact rfl
          · exact h₁)
    exact e₀, fun h₀ => by
    rcases h₀ with rfl
    simp [unwrap, wrap, free]⟩

/-! ## The attacker -/

/-- The public symbols: the public names and the public functions. -/
def pub : ∀ n, Fun n → Prop
  | _, .tag => False
  | _, .Register => False
  | _, .Ltk => False
  | _, .Pk => False
  | _, .Reveal => False
  | _, .Start => False
  | _, .St_1 => False
  | _, .Eq => False
  | _, .Accept => False
  | _, .Key => False
  | _, .Finish => False
  | _, .Unique => False
  | _, .Secret => False
  | _, .Unwrapped => False
  | _, .Projected => False
  | _, .Tick => False
  | _, .Both => False
  | _, .Announced => False
  | _, _ => True

/-- The attacker: the public names, the public functions and destructors, and the standard operations. -/
instance : Attacker T.Msg :=
  .ofDecls (fun n => {f | pub n f})
    {⟨3, liftFail fun a => verify (a 0) (a 1) (a 2)⟩, ⟨2, liftFail fun a => sdec (a 0) (a 1)⟩,
      ⟨2, liftFail fun a => unwrap (a 0) (a 1)⟩}

/-! ## Rules -/

/-- `rule Setup: [ Fr(~ltk) ] --[ Register($A) ]-> [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]` -/
def Rule.Setup : Rules T.Msg :=
  {s₀ |
    ∃ (ltk : ℕ) (A : String),
      s₀ =
        { fresh := [ltk], actions := [Fact.Register (pubName A)], outputs := [pk (nonce ltk)],
          produced := {Fact.Ltk (pubName A) (nonce ltk), Fact.Pk (pubName A) (pk (nonce ltk))} }}

/-- `rule Reveal: [ !Ltk(A, ltk) ] --[ Reveal(A) ]-> [ Out(ltk) ]` -/
def Rule.Reveal : Rules T.Msg :=
  {s₀ |
    ∃ (A ltk : T.Msg),
      s₀ = { persistent := [Fact.Ltk A ltk], actions := [Fact.Reveal A], outputs := [ltk] }}

/-- `rule Init: [ Fr(~x), Fr(~id), !Ltk($A, ltk) ] --[ Start($A, ~id) ]-> [ St_1($A, ~id, ~x), Out(<'g'^~x, sign('g'^~x, ltk)>), Out(tag(~id)) ]` -/
def Rule.Init : Rules T.Msg :=
  {s₀ |
    ∃ (x id : ℕ) (A : String) (ltk : T.Msg),
      s₀ =
        { persistent := [Fact.Ltk (pubName A) ltk], fresh := [x, id],
          actions := [Fact.Start (pubName A) (nonce id)],
          outputs :=
            [((exp (pubName "g") (nonce x), sign (exp (pubName "g") (nonce x)) ltk) : T.Msg),
              tag (nonce id)],
          produced := {Fact.St_1 (pubName A) (nonce id) (nonce x)} }}

/-- `rule Resp: [ Fr(~y), In(<gx, sig>), !Pk($A, pkA) ] --[ Eq(verify(sig, gx, pkA), true), Accept($A, gx^~y) ]-> [ Out('g'^~y), !Key($A, kdf(gx^~y, 'salt')) ]` -/
def Rule.Resp : Rules T.Msg :=
  {s₀ |
    ∃ (y : ℕ) (gx sig : T.Msg) (A : String) (pkA v₀ : T.Msg),
      verify sig gx pkA = some v₀ ∧
        s₀ =
          { persistent := [Fact.Pk (pubName A) pkA], inputs := [((gx, sig) : T.Msg)], fresh := [y],
            actions := [Fact.Eq v₀ (true : T.Msg), Fact.Accept (pubName A) (exp gx (nonce y))],
            outputs := [exp (pubName "g") (nonce y)],
            produced := {Fact.Key (pubName A) (kdf (exp gx (nonce y)) (pubName "salt"))} }}

/-- `rule Fin': [ St_1(A, id, x), In(gy) ] --[ Finish(A, id, gy^x), Unique(id) ]-> [ Secret(id, wrap(x, gy^x)), Out(wrap(h(id), gy^x)) ]` The model's `Fin`, renamed since the translation uses that name. -/
def Rule.Fin' : Rules T.Msg :=
  {s₀ |
    ∃ (A id x gy : T.Msg),
      s₀ =
        { consumed := {Fact.St_1 A id x}, inputs := [gy],
          actions := [Fact.Finish A id (exp gy x), Fact.Unique id],
          outputs := [wrap (h id) (exp gy x)], produced := {Fact.Secret id (wrap x (exp gy x))} }}

/-- `rule Unwrap: [ Secret(id, w), In(k) ] --[ Unwrapped(id, unwrap(w, k)) ]-> [ Out(unwrap(w, k)) ]` -/
def Rule.Unwrap : Rules T.Msg :=
  {s₀ |
    ∃ (id w k v₀ : T.Msg),
      unwrap w k = some v₀ ∧
        s₀ =
          { consumed := {Fact.Secret id w}, inputs := [k], actions := [Fact.Unwrapped id v₀],
            outputs := [v₀] }}

/-- `rule Proj: [ In(p) ] --[ Projected(fst(p), snd(p)) ]-> []` -/
def Rule.Proj : Rules T.Msg :=
  {s₀ |
    ∃ (p v₀ v₁ : T.Msg),
      fst p = some v₀ ∧ snd p = some v₁ ∧ s₀ = { inputs := [p], actions := [Fact.Projected v₀ v₁] }}

/-- `rule Tick: [] --[ Tick() ]-> []` -/
def Rule.Tick : Rules T.Msg :=
  {s₀ | s₀ = { actions := [Fact.Tick] }}

/-- `rule Both: [ In(a), In(b), Fr(~n), Fr(~m) ] --[ Both(a, b, ~n) ]-> [ Out(<a, b, ~n, ~m>) ]` -/
def Rule.Both : Rules T.Msg :=
  {s₀ |
    ∃ (a b : T.Msg) (n m : ℕ),
      s₀ =
        { inputs := [a, b], fresh := [n, m], actions := [Fact.Both a b (nonce n)],
          outputs := [((a, ((b, ((nonce n, nonce m) : T.Msg)) : T.Msg)) : T.Msg)] }}

/-- `rule Announce: [] --[ Announced($B, 'c') ]-> [ Out(<$B, 'c'>) ]` -/
def Rule.Announce : Rules T.Msg :=
  {s₀ |
    ∃ (B : String),
      s₀ =
        { actions := [Fact.Announced (pubName B) (pubName "c")],
          outputs := [((pubName B, pubName "c") : T.Msg)] }}

/-! ## The system -/

/-- The channel, a public name: the network is the attacker. -/
def channel : T.Msg :=
  pubName "net"

/-- The rules. -/
def rules : Rules T.Msg :=
  Rule.Setup ∪ Rule.Reveal ∪ Rule.Init ∪ Rule.Resp ∪ Rule.Fin' ∪ Rule.Unwrap ∪ Rule.Proj ∪
        Rule.Tick ∪
      Rule.Both ∪
    Rule.Announce

/-- The system: the process of the rules. -/
def system : Proc T.Msg :=
  Rules.proc channel rules

/-- The system is prefix-closed. -/
theorem system_mem_tree : system ∈ Descriptive.tree (Act T.Msg) :=
  Rules.proc_mem_tree channel rules

/-! ## Restrictions -/

/-- `restriction Equality: "All x y #i. Eq(x, y) @ #i ==> x = y"` -/
def Restriction.Equality (t₀ : Trace T.Msg) : Prop :=
  ∀ (x y : T.Msg) (i : ℕ), ActionAt t₀ i (Fact.Eq x y) → x = y

/-- `restriction Once: "All id #i #j. Unique(id) @ #i & Unique(id) @ #j ==> #i = #j"` -/
def Restriction.Once (t₀ : Trace T.Msg) : Prop :=
  ∀ (id : T.Msg) (i j : ℕ), ActionAt t₀ i (Fact.Unique id) ∧ ActionAt t₀ j (Fact.Unique id) → i = j

/-- The restrictions, together. -/
def Restrictions (t₀ : Trace T.Msg) : Prop :=
  Restriction.Equality t₀ ∧ Restriction.Once t₀

/-! ## Lemmas -/

/-- `lemma secrecy [reuse]: "All A id k #i. Finish(A, id, k) @ #i & not(Ex #r. Reveal(A) @ #r & #r < #i) ==> not(Ex #j. K(k) @ #j)"` -/
def Lemma.secrecy : Prop :=
  ∀ t₀ ∈ system.Attacks,
    Restrictions t₀ →
      ∀ (A id k : T.Msg) (i : ℕ),
        (ActionAt t₀ i (Fact.Finish A id k) ∧ ¬∃ (r : ℕ), ActionAt t₀ r (Fact.Reveal A) ∧ r < i) →
          ¬∃ (j : ℕ), KnowsAt t₀ j k

/-- `lemma executable: exists-trace "Ex A id k #i #j. Start(A, id) @ #i & Finish(A, id, k) @ #j & #i < #j"` -/
def Lemma.executable : Prop :=
  ∃ t₀ ∈ system.Attacks,
    Restrictions t₀ ∧
      ∃ (A id k : T.Msg) (i j : ℕ),
        (ActionAt t₀ i (Fact.Start A id) ∧ ActionAt t₀ j (Fact.Finish A id k)) ∧ i < j

/-! `lemma typing` is not translated: it mentions `KU`. -/

/-- `lemma mixed: "All $B ~id #i. Announced($B, 'c') @ #i ==> T | (F <=> (Ex #j. Tick() @ #j))"` -/
def Lemma.mixed : Prop :=
  ∀ t₀ ∈ system.Attacks,
    Restrictions t₀ →
      ∀ (B : String) (_id i : ℕ),
        ActionAt t₀ i (Fact.Announced (pubName B) (pubName "c")) →
          True ∨ (False ↔ ∃ (j : ℕ), ActionAt t₀ j Fact.Tick)

end Fragment

