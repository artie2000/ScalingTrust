/-! ## Names -/

/-- The `n`-th fresh name. -/
def nonce (n : ℕ) : T.Msg :=
  .name n

/-- The public name `a`. -/
def pubName (a : String) : T.Msg :=
  .app (.inl (.const a)) ![]

/-! ## Functions -/

def h (x₀ : T.Msg) : T.Msg :=
  .app (.inl .h) ![x₀]

def aenc (x₀ x₁ : T.Msg) : T.Msg :=
  .app (.inl .aenc) ![x₀, x₁]

def pk (x₀ : T.Msg) : T.Msg :=
  .app (.inl .pk) ![x₀]

/-! ## Facts -/

def Fact.Ltk (x₀ x₁ : T.Msg) : T.Msg :=
  .app (.inl .Ltk) ![x₀, x₁]

def Fact.Pk (x₀ x₁ : T.Msg) : T.Msg :=
  .app (.inl .Pk) ![x₀, x₁]

def Fact.LtkReveal (x₀ : T.Msg) : T.Msg :=
  .app (.inl .LtkReveal) ![x₀]

def Fact.Client_1 (x₀ x₁ : T.Msg) : T.Msg :=
  .app (.inl .Client_1) ![x₀, x₁]

def Fact.SessKeyC (x₀ x₁ : T.Msg) : T.Msg :=
  .app (.inl .SessKeyC) ![x₀, x₁]

def Fact.AnswerRequest (x₀ x₁ : T.Msg) : T.Msg :=
  .app (.inl .AnswerRequest) ![x₀, x₁]

/-! ## Destructors -/

/-- `adec(aenc(m, pk(sk)), sk) → m` -/
def adec (x₀ x₁ : T.Msg) : Option T.Msg :=
  match x₀.view with
  | .app (.inl .aenc) a₀ => if a₀ 1 = pk x₁ then some (a₀ 0) else none
  | _ => none

/-! ### The destructors' graphs are their rules -/

theorem adec_eq_some {x₀ x₁ m₀ : T.Msg} : adec x₀ x₁ = some m₀ ↔ x₀ = aenc m₀ (pk x₁) :=
  ⟨fun h₀ => by
    rcases hv₀ : x₀.view with _ | ⟨f₀, a₀⟩ | _ <;> simp [adec, hv₀] at h₀
    rcases f₀ with f₀ | f₀ <;> cases f₀ <;> try simp at h₀
    rcases h₀ with ⟨h₁, h₂⟩
    subst h₂
    have e₀ : x₀ = aenc (a₀ 0) (pk x₁) :=
      x₀.eq_app_of_view' hv₀
        (by
          intro i₀
          fin_cases i₀
          · exact rfl
          · exact h₁)
    exact e₀, fun h₀ => by
    rcases h₀ with rfl
    simp [adec, aenc, pk, free]⟩

/-! ## The attacker -/

/-- The public symbols: the public names and the public functions. -/
def pub : ∀ n, Fun n → Prop
  | _, .Ltk => False
  | _, .Pk => False
  | _, .LtkReveal => False
  | _, .Client_1 => False
  | _, .SessKeyC => False
  | _, .AnswerRequest => False
  | _, _ => True

/-- The attacker: the public names, the public functions and destructors, and the standard operations. -/
instance : Attacker T.Msg :=
  .ofDecls (fun n => {f | pub n f}) {⟨2, liftFail fun a => adec (a 0) (a 1)⟩}

/-! ## Rules -/

/-- `rule Register_pk: [ Fr(~ltk) ] --> [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)) ]` -/
def Rule.Register_pk : Rules T.Msg :=
  {s₀ |
    ∃ (ltk : ℕ) (A : String),
      s₀ =
        { fresh := [ltk],
          produced := {Fact.Ltk (pubName A) (nonce ltk), Fact.Pk (pubName A) (pk (nonce ltk))} }}

/-- `rule Get_pk: [ !Pk(A, pubkey) ] --> [ Out(pubkey) ]` -/
def Rule.Get_pk : Rules T.Msg :=
  {s₀ | ∃ (A pubkey : T.Msg), s₀ = { persistent := [Fact.Pk A pubkey], outputs := [pubkey] }}

/-- `rule Reveal_ltk: [ !Ltk(A, ltk) ] --[ LtkReveal(A) ]-> [ Out(ltk) ]` -/
def Rule.Reveal_ltk : Rules T.Msg :=
  {s₀ |
    ∃ (A ltk : T.Msg),
      s₀ = { persistent := [Fact.Ltk A ltk], actions := [Fact.LtkReveal A], outputs := [ltk] }}

/-- `rule Client_1: [ Fr(~k), !Pk($S, pkS) ] --> [ Client_1($S, ~k), Out(aenc(~k, pkS)) ]` -/
def Rule.Client_1 : Rules T.Msg :=
  {s₀ |
    ∃ (k : ℕ) (S : String) (pkS : T.Msg),
      s₀ =
        { persistent := [Fact.Pk (pubName S) pkS], fresh := [k], outputs := [aenc (nonce k) pkS],
          produced := {Fact.Client_1 (pubName S) (nonce k)} }}

/-- `rule Client_2: [ Client_1(S, k), In(h(k)) ] --[ SessKeyC(S, k) ]-> []` -/
def Rule.Client_2 : Rules T.Msg :=
  {s₀ |
    ∃ (S k : T.Msg),
      s₀ = { consumed := {Fact.Client_1 S k}, inputs := [h k], actions := [Fact.SessKeyC S k] }}

/-- `rule Serv_1: [ !Ltk($S, ~ltkS), In(request) ] --[ AnswerRequest($S, adec(request, ~ltkS)) ]-> [ Out(h(adec(request, ~ltkS))) ]` -/
def Rule.Serv_1 : Rules T.Msg :=
  {s₀ |
    ∃ (S : String) (ltkS : ℕ) (request v₀ : T.Msg),
      adec request (nonce ltkS) = some v₀ ∧
        s₀ =
          { persistent := [Fact.Ltk (pubName S) (nonce ltkS)], inputs := [request],
            actions := [Fact.AnswerRequest (pubName S) v₀], outputs := [h v₀] }}

/-! ## The system -/

/-- The channel, a public name: the network is the attacker. -/
def channel : T.Msg :=
  pubName "net"

/-- The rules. -/
def rules : Rules T.Msg :=
  Rule.Register_pk ∪ Rule.Get_pk ∪ Rule.Reveal_ltk ∪ Rule.Client_1 ∪ Rule.Client_2 ∪ Rule.Serv_1

/-- The system: the process of the rules. -/
def system : Proc T.Msg :=
  Rules.proc channel rules

/-- The system is prefix-closed. -/
theorem system_mem_tree : system ∈ Descriptive.tree (Act T.Msg) :=
  Rules.proc_mem_tree channel rules

/-! ## Lemmas -/

/-- `lemma Client_session_key_secrecy: "not(Ex S k #i #j. SessKeyC(S, k) @ #i & K(k) @ #j & not(Ex #r. LtkReveal(S) @ #r))"` -/
def Lemma.Client_session_key_secrecy : Prop :=
  ∀ t₀ ∈ system.Attacks,
    ¬∃ (S k : T.Msg) (i j : ℕ),
        (ActionAt t₀ i (Fact.SessKeyC S k) ∧ KnowsAt t₀ j k) ∧
          ¬∃ (r : ℕ), ActionAt t₀ r (Fact.LtkReveal S)

