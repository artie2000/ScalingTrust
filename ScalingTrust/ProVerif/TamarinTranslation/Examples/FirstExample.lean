    ∀ (S k : T.Msg) (i : ℕ),
      ActionAt t₀ i (Fact.SessKeyC S k) →
        (∃ (a : ℕ), ActionAt t₀ a (Fact.AnswerRequest S k)) ∨
          ∃ (r : ℕ), ActionAt t₀ r (Fact.LtkReveal S) ∧ r < i

/-- `lemma Client_auth_injective: "All S k #i. SessKeyC(S, k) @ #i ==> (Ex #a. AnswerRequest(S, k) @ #a & (All #j. SessKeyC(S, k) @ #j ==> #i = #j)) | (Ex #r. LtkReveal(S) @ #r & #r < #i)"` -/
def Lemma.Client_auth_injective : Prop :=
  ∀ t₀ ∈ system.Attacks,
    ∀ (S k : T.Msg) (i : ℕ),
      ActionAt t₀ i (Fact.SessKeyC S k) →
        (∃ (a : ℕ),
            ActionAt t₀ a (Fact.AnswerRequest S k) ∧
              ∀ (j : ℕ), ActionAt t₀ j (Fact.SessKeyC S k) → i = j) ∨
          ∃ (r : ℕ), ActionAt t₀ r (Fact.LtkReveal S) ∧ r < i

/-- `lemma Client_session_key_honest_setup: exists-trace "Ex S k #i. SessKeyC(S, k) @ #i & not(Ex #r. LtkReveal(S) @ #r)"` -/
def Lemma.Client_session_key_honest_setup : Prop :=
  ∃ t₀ ∈ system.Attacks,
    ∃ (S k : T.Msg) (i : ℕ),
      ActionAt t₀ i (Fact.SessKeyC S k) ∧ ¬∃ (r : ℕ), ActionAt t₀ r (Fact.LtkReveal S)

